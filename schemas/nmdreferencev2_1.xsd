                    <xs:documentation>
                        <imrd:imrDoc>
                            <imrd:description lang="no">Fritekst beskrivelse av sertifisering for art.</imrd:description>
                            <imrd:description lang="en">Freetext description og certification.</imrd:description>
                        </imrd:imrDoc>
                    </xs:documentation>
                </xs:annotation>                     
            </xs:element>
            <xs:element name="comment" type="StringWithAnyAttributes" minOccurs="0" maxOccurs="1">          
