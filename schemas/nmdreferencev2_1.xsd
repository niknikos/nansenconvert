    <xs:complexType name="TableInfoType">
        <xs:sequence>
            <xs:element name="id" type="xs:string" minOccurs="0" maxOccurs="1" />       
            <xs:element name="name" type="StringWithAnyAttributes" minOccurs="0" maxOccurs="1" >
                <xs:annotation>
                    <xs:documentation>
                        <imrd:imrDoc>
                            <imrd:description lang="no">Navn på tabell.</imrd:description>
                            <imrd:description lang="en">Name of the table.</imrd:description>
                        </imrd:imrDoc>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>       
            <xs:element name="description" type="StringWithAnyAttributes" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <imrd:imrDoc>
                            <imrd:description lang="no">Beskrivelse av tabellen.</imrd:description>
                            <imrd:description lang="en">Description of the table.</imrd:description>
                        </imrd:imrDoc>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>    
            <xs:element name="idDataset" type="xs:string" minOccurs="0" maxOccurs="1" />                  
        </xs:sequence>
        <xs:attributeGroup ref="GenericAttrRowGroup" />  
        <xs:attribute name="deprecated" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <imrd:imrDoc>
                        <imrd:description lang="no">Beskriver om en tabell ikke lengere skal brukes.</imrd:description>
                        <imrd:description lang="en">Describes whether a table is currently in use.</imrd:description>
                    </imrd:imrDoc>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="validFrom" type="xs:dateTime"/>
        <xs:attribute name="validTo" type="xs:dateTime"/>  
        <xs:attribute name="newtable" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    <imrd:imrDoc>
                        <imrd:description lang="no">Hvis en tabell ikke lengere er i bruk, så kan det her beskrives hvilken tabell som har tatt over.</imrd:description>
                        <imrd:description lang="en">If a table is no longer in use, a new tablename can be used here to tell the name of the new table.</imrd:description>
                    </imrd:imrDoc>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>            
    
   
